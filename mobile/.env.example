# Backend URL used by the Expo app.
#
# Android Emulator: http://10.0.2.2:5000 (the code uses this by default)
# iOS Simulator: http://localhost:5000 (the code uses this by default)
# Physical device with Expo Go: use the computer's LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
EXPO_PUBLIC_API_URL=
