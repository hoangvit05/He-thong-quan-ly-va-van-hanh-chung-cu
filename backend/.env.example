# =========================================================================
# 1. CẤU HÌNH SERVER RUNTIME (LOCAL DEVELOPMENT)
# Sử dụng cho việc phát triển cục bộ và chạy dev server (npm run dev)
# =========================================================================
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apartment_db"
JWT_SECRET="super-secret-jwt-key"

# =========================================================================
# 2. CẤU HÌNH POSTGRESQL TEST CONTAINER (DOCKER COMPOSE)
# Biến môi trường bắt buộc khi khởi tạo container qua docker-compose.test.yml
# Không có mật khẩu mặc định/fallback (Compose sẽ từ chối khởi động nếu thiếu)
# =========================================================================
# POSTGRES_PASSWORD="your_secure_test_admin_password_here"
# POSTGRES_APP_PASSWORD="your_secure_test_app_password_here"

# =========================================================================
# 3. CẤU HÌNH INTEGRATION TEST RUNNER (TEST_APP_USER - LEAST PRIVILEGE)
# Biến DATABASE_URL bắt buộc phải truyền khi chạy: npm run test:integration
# Lưu ý: Safety Guard sẽ từ chối nếu không trỏ vào đúng database apartment_test
#        hoặc nếu dùng tài khoản superuser (test_user/postgres).
# =========================================================================
# DATABASE_URL="postgresql://test_app_user:your_secure_test_app_password_here@127.0.0.1:5432/apartment_test?schema=public"
